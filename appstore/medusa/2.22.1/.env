# Postgres 服务 (前置检查) [必填] 
PANEL_POSTGRES_TYPE=postgresql

# Redis 服务 (前置检查) [必填] 
PANEL_REDIS_TYPE=redis

# WebUI 端口 [必填] 
PANEL_APP_PORT_HTTP=9000

# 数据库 主机地址 [必填] 
POSTGRES_HOST=127.0.0.1

# 数据库 端口 [必填] 
POSTGRES_PORT=5432

# 数据库 名称 [必填] 
POSTGRES_NAME=medusa

# 数据库 用户名 [必填] 
POSTGRES_USER=medusa

# 数据库 密码 [必填] 
POSTGRES_PASSWORD=

# 数据库 SSL 模式 [必填] 
POSTGRES_SSLMODE=disable

# Redis 连接地址 [必填] 
REDIS_URL=redis://127.0.0.1:6379/0

# JWT 密钥 [必填] 
JWT_SECRET=

# Cookie 密钥 [必填] 
COOKIE_SECRET=

# Store API 允许来源 (中英文逗号分隔) [必填] 
STORE_CORS=http://127.0.0.1:8000

# Admin 允许来源 (中英文逗号分隔) [必填] 
ADMIN_CORS=http://127.0.0.1:9000

# 认证接口允许来源 (中英文逗号分隔) [必填] 
AUTH_CORS=http://127.0.0.1:9000

# Session Cookie 仅 HTTPS (纯 HTTP 访问请选择禁止) [必填] 
COOKIE_SECURE=false

# Session Cookie SameSite [必填] 
COOKIE_SAME_SITE=lax

