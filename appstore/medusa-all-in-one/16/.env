# 数据持久化路径 [必填] 
MEDUSA_ROOT_PATH=/home/medusa

# WebUI 端口 [必填] 
PANEL_APP_PORT_HTTP=9000

# 数据库 密码 [必填] 
POSTGRES_PASSWORD=

# JWT 密钥 [必填] 
JWT_SECRET=

# Cookie 密钥 [必填] 
COOKIE_SECRET=

# Store API 允许来源 (中英文逗号分隔) [必填] 
STORE_CORS=http://127.0.0.1:8000

# Admin 允许来源 (中英文逗号分隔) [必填] 
ADMIN_CORS=http://127.0.0.1:9000

# 认证接口允许来源 (中英文逗号分隔) [必填] 
AUTH_CORS=http://127.0.0.1:9000

# API 地址 [必填] 
BACKEND_URL=http://127.0.0.1:9000

# Session Cookie 仅 HTTPS (纯 HTTP 访问请选择禁止) [必填] 
COOKIE_SECURE=false

# Session Cookie SameSite [必填] 
COOKIE_SAME_SITE=lax

# 支付宝 应用 ID (APPID，留空不启用) 
ALIPAY_APP_ID=

# 支付宝 应用私钥 (完整 PEM 或单行均可) 
ALIPAY_PRIVATE_KEY=

# 支付宝 公钥 (非应用公钥，完整 PEM 或单行均可) 
ALIPAY_PUBLIC_KEY=

# 支付宝 商户 PID (留空不校验) 
ALIPAY_SELLER_ID=

# 支付宝 网关 (留空为生产环境) 
ALIPAY_GATEWAY=

# 支付宝 异步通知地址 (留空为 API 地址+/webhooks/alipay) 
ALIPAY_NOTIFY_URL=

# 支付宝 同步回跳地址 (留空自动生成) 
ALIPAY_RETURN_URL=

# 支付宝 订单标题前缀 
ALIPAY_SUBJECT_PREFIX=Order

