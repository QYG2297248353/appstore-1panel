# MySQL 服务 (前置检查) [必填] 
PANEL_DB_TYPE=mysql

# 数据持久化路径 [必填] 
NEXUS_MEDIA_ROOT_PATH=/home/nexus-media

# 媒体库路径 [必填] 
NEXUS_MEDIA_MEDIA_PATH=/home/nexus-media/media

# WebUI 端口 [必填] 
PANEL_APP_PORT_HTTP=8080

# 后端 API 端口 [必填] 
PANEL_APP_PORT_API=3000

# 运行用户 UID [必填] 
PUID=0

# 运行用户 GID [必填] 
PGID=0

# 数据库 主机地址 [必填] 
DB_HOSTNAME=127.0.0.1

# 数据库 端口 [必填] 
DB_PORT=3306

# 数据库 用户名 [必填] 
DB_USERNAME=nexus_media

# 数据库 密码 [必填] 
DB_PASSWORD=

# 数据库 名称 [必填] 
DB_DATABASE_NAME=nexus_media

