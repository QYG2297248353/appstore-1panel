# 数据持久化路径 [必填] 
ZTNET_ROOT_PATH=/home/ztnet

# WebUI 端口 [必填] 
PANEL_APP_PORT_HTTP=3000

# 加密密钥 [必填] 
NEXTAUTH_SECRET=

# ZeroTier 地址 [必填] 
ZT_ADDR=http://127.0.0.1:9993

# ZeroTier 密钥 [必填] 
ZT_SECRET=authtoken.secret

# WebUI 访问地址 [必填] 
NEXTAUTH_URL=http://localhost:3000

# 会话过期时间（秒） [必填] 
NEXTAUTH_SESSION_MAX_AGE=21600

