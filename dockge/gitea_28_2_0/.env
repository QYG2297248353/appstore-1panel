# 数据持久化路径 [必填] 
GITEA_ROOT_PATH=/home/gitea

# WebUI 端口 [必填] 
PANEL_APP_PORT_HTTP=3000

# SSH 端口 [必填] 
PANEL_APP_PORT_SSH=22

# 应用名称 [必填] 
APP_NAME=Gitea: Git with a cup of tea

# 公共 URL 
ROOT_URL=http://localhost:3000/

# SSH 克隆端口 [必填] 
SSH_PORT=22

# 启用 Git LFS 支持 [必填] 
LFS_START_SERVER=false

# 全局加密密钥 
SECRET_KEY=

# 自主注册功能 [必填] 
DISABLE_REGISTRATION=false

# 公开探索仓库 [必填] 
REQUIRE_SIGNIN_VIEW=false

# 是否允许访问安装页面 [必填] 
INSTALL_LOCK=false

# 数据库 类型 [必填] 
DB_TYPE=postgres

# 数据库 地址 
DB_HOSTNAME=127.0.0.1

# 数据库 端口 
DB_PORT=5432

# 数据库 用户名 
DB_USER=gitea

# 数据库 密码 
DB_PASSWD=

# 数据库 名称 
DB_NAME=gitea

# 启用代理 (全局 + Webhook) [必填] 
PROXY_ENABLED=false

# 代理服务器地址 (全局 + Webhook) 
PROXY_URL=

# 代理网址 (全局 + Webhook) 
PROXY_HOSTS=**

