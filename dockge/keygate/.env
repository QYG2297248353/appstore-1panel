# Postgres 服务 (前置检查) [必填] 
PANEL_POSTGRES_TYPE=postgresql

# Redis 服务 (前置检查) [必填] 
PANEL_REDIS_TYPE=redis

# WebUI 端口 [必填] 
PANEL_APP_PORT_HTTP=9000

# 服务外部地址 [必填] 
BASE_URL=http://127.0.0.1:9000

# 数据库 主机地址 [必填] 
POSTGRES_HOST=127.0.0.1

# 数据库 端口 [必填] 
POSTGRES_PORT=5432

# 数据库 名称 [必填] 
POSTGRES_NAME=keygate

# 数据库 用户名 [必填] 
POSTGRES_USER=keygate

# 数据库 密码 [必填] 
POSTGRES_PASSWORD=

# Redis 连接地址 [必填] 
REDIS_URL=redis://127.0.0.1:6379/0

# JWT 密钥 [必填] 
JWT_SECRET=

# 许可证签名密钥 [必填] 
LICENSE_SIGNING_KEY=

# 发布密钥加密密钥 (推荐) 
RELEASE_KEY_ENCRYPTION_KEY=

# Stripe 密钥 (可选) 
STRIPE_SECRET_KEY=

# SMTP 主机 (可选) 
SMTP_HOST=

# SMTP 端口 [必填] 
SMTP_PORT=587

# SMTP 用户名 (可选) 
SMTP_USERNAME=

# SMTP 密码 (可选) 
SMTP_PASSWORD=

# SMTP 发件人 (可选) 
SMTP_FROM=

# 管理员邮箱 (逗号分隔) 
ADMIN_EMAILS=

