# 镜像源 [必填] 
SPEED_TEST_IMAGE=lscr.io/linuxserver/speedtest-tracker:0.18.3

# 数据持久化 根路径 [必填] 
SP_TRACKER_ROOT_PATH=/home/speedtest-tracker

# Web 服务端口 [必填] 
PANEL_APP_PORT_HTTP=8080

# SSL 服务端口 [必填] 
PANEL_APP_PORT_HTTPS=8443

# 时区 
SP_TRACKER_TZ=Asia/Shanghai

# 数据库驱动类型 [必填] 
SP_TRACKER_DB_TYPE=sqlite

# 数据库主机IP 
SP_TRACKER_DB_HOST=localhost

# 数据库端口 (默认3306) 
SP_TRACKER_DB_PORT=3306

# 数据库 用户名 
SP_TRACKER_DB_USER=speedtest_tracker

# 数据库 用户名密码 
SP_TRACKER_DB_PASSWORD=speedtest_tracker

# 数据库名称 
MYSQL_SERVICE_DB_NAME=speedtest_tracker

# 加密存储数据的应用程序密钥 (Base64 开头) 
SP_TRACKER_APP_KEY=

# 用户ID 
PUID=1000

# 组ID 
PGID=1000

# 协议 (SMTP) 
MAIL_MAILER=smtp

# 邮件服务器地址 (SMTP) 
MAIL_HOST=smtp.163.com

# 邮件用户名 (SMTP) 
MAIL_USERNAME=

# 邮件账户密码 (SMTP) 
MAIL_PASSWORD=

# 邮件加密方式 (SMTP) 
MAIL_ENCRYPTION=ssl

# 邮件发送地址 (SMTP) 
MAIL_FROM_ADDRESS=

# 邮件发送者名称 (SMTP) 
MAIL_FROM_NAME=

# 机器人的令牌 ID (通知 Telegram) 
TELEGRAM_BOT_TOKEN=

